# LLM (at least one required)
OPENAI_API_KEY=sk-...

# Polymarket (Polygon)
EVM_PRIVATE_KEY=0x...
CLOB_API_KEY=...
CLOB_API_SECRET=...
CLOB_API_PASSPHRASE=...
POLYMARKET_SIGNATURE_TYPE=1
POLYMARKET_FUNDER_ADDRESS=0x...
FUNDER_ADDRESS=0x...

# Jupiter (Solana)
JUPITER_API_KEY=...
SOLANA_PRIVATE_KEY=...               # Base58
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# x402 Payment Protocol
X402_ENABLED=true
X402_MAX_PAYMENT_USD=0.10
X402_API_URL=https://your-x402-server.railway.app

# Server
WS_PORT=3001

# WebSocket Authentication (optional — if set, clients must send auth token)
# WS_AUTH_TOKEN=your-secret-token-here

# Database
POSTGRES_URL=postgresql://...
PGLITE_DATA_DIR=memory://

# RAG Pipeline
CHROMA_URL=http://localhost:8000
NEWSAPI_API_KEY=
TAVILY_API_KEY=

# Trading Configuration (all optional — sensible defaults built in)
# MAX_SHARES_PER_ORDER=500
# MAX_POSITIONS=50
# MIN_BET_SIZE_USD=3
# MAX_BET_SIZE_USD=6
# BASE_BET_SIZE_USD=3
# SELL_LOSS_THRESHOLD_NORMAL=-15
# SELL_LOSS_THRESHOLD_AGGRESSIVE=-5
# SELL_PROFIT_THRESHOLD_NORMAL=25
# SELL_PROFIT_THRESHOLD_AGGRESSIVE=5
# LOW_BALANCE_THRESHOLD=3
# AUTONOMY_INTERVAL_MS=60000
# HEARTBEAT_INTERVAL_MS=10000
# MAX_RETRIES=3
# RETRY_BASE_DELAY_MS=1000
# DAILY_SPEND_LIMIT_USD=50
# HEARTBEAT_MAX_FAILURES=5
